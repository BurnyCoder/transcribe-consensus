# Copy to .env and fill in. All TRANSCRIBE_* values are optional and can be overridden on the CLI.
OPENAI_API_KEY=sk-...
# Comma-separated models: whisper-1, gpt-4o-transcribe, gpt-4o-mini-transcribe, gpt-4o-transcribe-diarize
TRANSCRIBE_MODELS=whisper-1,gpt-4o-transcribe,gpt-4o-transcribe-diarize
# Comma-separated ISO-639-1 codes to pin (e.g. "cs,sk"); empty = auto-detect
TRANSCRIBE_LANGUAGES=
# Vocabulary / spelling hint for the speech-to-text models (names, jargon)
TRANSCRIBE_PROMPT=
# Free-text description of the recording, given to the merge model
TRANSCRIBE_CONTEXT=
# Chat model used to reconcile the transcripts
TRANSCRIBE_MERGE_MODEL=gpt-5
TRANSCRIBE_OUT=output
