# Copy to .env and fill in. All TRANSCRIBE_* values are optional and can be overridden on the CLI.
OPENAI_API_KEY=sk-...
# Comma-separated models: gpt-transcribe, whisper-1, gpt-4o-transcribe, gpt-4o-mini-transcribe, gpt-4o-transcribe-diarize
TRANSCRIBE_MODELS=gpt-transcribe,whisper-1,gpt-4o-transcribe-diarize
# Comma-separated ISO-639-1 codes to hint (e.g. "cs,sk"); empty = auto-detect
TRANSCRIBE_LANGUAGES=
# Vocabulary / spelling hint for the speech-to-text models (names, jargon)
TRANSCRIBE_PROMPT=
# Free-text description of the recording, given to the merge and correction models
TRANSCRIBE_CONTEXT=
# Chat model used to reconcile the transcripts
TRANSCRIBE_MERGE_MODEL=gpt-6-astra
# Chat model used to fix likely mistranscriptions in the consensus
TRANSCRIBE_CORRECT_MODEL=gpt-6-astra
TRANSCRIBE_OUT=output
